# Backend (FastAPI) image. CPU-only PyTorch keeps the image small.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install ".[api,tracking]"
COPY scripts ./scripts
COPY configs ./configs
COPY data/metadata ./data/metadata
COPY reports/experiment-results ./reports/experiment-results
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD curl -fsS http://localhost:8000/api/health || exit 1
ENTRYPOINT ["/entrypoint.sh"]
